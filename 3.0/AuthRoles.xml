<Roles>
    <AppRoles>
        <Role name='canopenapp'>Allow access to App</Role>
        <Role name='canruncalculator'>Allow to run the calculator</Role>
        <Role name='canviewreports'>Allow to view reports</Role>
        <Role name='canconfigurepages'>Allow to configure pages</Role>
        <Role name='canbulkupload'>Allow to bulk upload products</Role>
         
    </AppRoles>
    <UserRoles>
        <UserRole name='Administrator' roles='canopenapp,canconfigurepages,canbulkupload' />
        <UserRole name='Calculator' roles='canopenapp,canruncalculator' />
        <UserRole name='Viewer' roles='canopenapp,canviewreports' />
    </UserRoles>

    <Default visible='#{authrole.canopenapp?}' />

</Roles>
